---
// src/components/About.astro
import ProfileCard from '../components/ui/ProfileCard.jsx';
---

<section class="about-section" id="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2>About Me</h2>
        <p>
          I am <strong>Kritagya Kafle</strong>, a graphic designer, video editor, and creative visual strategist who also builds modern full-stack web applications. With a foundation rooted in high-impact visual design, scroll-stopping social carousels, video editing, and brand storytelling, I approach every project as an engaging visual experience to shape from the ground up.
        </p>
        <p>
          Alongside design and motion graphics, I develop fast, scalable web software using React, Astro, Next.js, and TypeScript. From high-throughput web scraping utilities and automated workflows to finance dashboards, tourism portals, and interactive games, I bridge the gap where graphic design meets software engineering — ensuring every layout, motion beat, and codebase is intentional, fast, and memorable.
        </p>
      </div>
      
      <div class="about-image-wrapper">
        <ProfileCard
          client:load
          name="Kritagya Kafle"
          title="Student"
          handle="kritagyakafle"
          status="Online"
          contactText="Contact Me"
          avatarUrl="/me.webp"
          showUserInfo={true}
          enableTilt={true}
          enableMobileTilt={false}
          behindGlowEnabled={true}
          behindGlowColor="rgba(11, 130, 138, 0.67)"
          innerGradient="linear-gradient(145deg, rgba(11, 130, 138, 0.45) 0%, rgba(122, 91, 160, 0.3) 100%)"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: clamp(4.5rem, 12vh, 9rem) clamp(1rem, 5vw, 5%);
    background-color: var(--bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-content {
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  .about-text {
    flex: 1;
  }

  .about-text h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .about-text p {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .about-image-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 900px) {
    .about-content {
      flex-direction: column-reverse;
      gap: 3rem;
      text-align: center;
    }

    .about-text {
      text-align: center;
      width: 100%;
    }

    .about-text h2 {
      text-align: center;
      word-break: keep-all;
      hyphens: none;
      -webkit-hyphens: none;
    }

    .about-text p {
      text-align: center;
      max-width: 620px;
      margin-left: auto;
      margin-right: auto;
      word-break: keep-all;
      hyphens: none;
      -webkit-hyphens: none;
    }

    .about-image-wrapper { 
      width: 100%; 
      display: flex;
      justify-content: center;
      align-items: center;
    }
  }

  @media (max-width: 480px) {
    .about-text h2 { margin-bottom: 1rem; text-align: center; font-size: 2.2rem; }
    .about-text p { font-size: 1rem; margin-bottom: 1.1rem; text-align: center; line-height: 1.65; }
  }
</style>
