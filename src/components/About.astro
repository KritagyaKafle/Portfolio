---
// src/components/About.astro
import ProfileCard from '../components/ui/ProfileCard.jsx';
---

<section class="about-section" id="about">
  <div class="container">
    <div class="about-content">
      <div class="about-text">
        <h2>About Me</h2>
        <p>
          I am a graphic designer transitioning into frontend development. I believe that the best digital experiences are built at the intersection of aesthetic intent and technical precision.
        </p>
        <p>
          Coming from a background in motion graphics and brand identity, I approach code not just as logic, but as a medium for interactive storytelling. Every animation, transition, and layout is a deliberate design choice.
        </p>
      </div>
      
      <div class="about-image-wrapper">
        <ProfileCard
          client:load
          name="Kritagya Kafle"
          title="Student"
          handle="kritagyakafle"
          status="Online"
          contactText="Contact Me"
          avatarUrl="/me.webp"
          showUserInfo={true}
          enableTilt={true}
          enableMobileTilt={false}
          behindGlowEnabled={true}
          behindGlowColor="rgba(11, 130, 138, 0.67)"
          innerGradient="linear-gradient(145deg, rgba(11, 130, 138, 0.35) 0%, rgba(122, 91, 160, 0.2) 100%)"
        />
      </div>
    </div>
  </div>
</section>

<style>
  .about-section {
    padding: clamp(4.5rem, 12vh, 9rem) clamp(1rem, 5vw, 5%);
    background-color: var(--bg);
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
  }

  .about-content {
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  .about-text {
    flex: 1;
  }

  .about-text h2 {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 4vw, 3.5rem);
    font-weight: 800;
    margin-bottom: 1.5rem;
    color: var(--text);
    letter-spacing: -0.02em;
  }

  .about-text p {
    font-size: 1.1rem;
    line-height: 1.75;
    color: var(--text-secondary);
    margin-bottom: 1.5rem;
  }

  .about-image-wrapper {
    flex: 1;
    display: flex;
    justify-content: center;
    align-items: center;
  }

  @media (max-width: 900px) {
    .about-content {
      flex-direction: column-reverse;
      gap: 3rem;
      text-align: center;
    }

    .about-image-wrapper { width: 100%; }
  }

  @media (max-width: 480px) {
    .about-text h2 { margin-bottom: 1rem; }
    .about-text p { font-size: 1rem; margin-bottom: 1.1rem; }
  }
</style>
