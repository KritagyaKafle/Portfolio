<style>
  .contact-section {
    padding: clamp(4.5rem, 12vh, 9rem) clamp(1rem, 5vw, 5%) clamp(4rem, 10vh, 7rem);
    background-color: var(--bg);
    text-align: center;
  }

  .container {
    max-width: 800px;
    margin: 0 auto;
  }

  p {
    font-size: 1.125rem;
    color: var(--text-secondary);
    margin-bottom: 3rem;
  }

  .email-link {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 5.8vw, 2.5rem);
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
    transition: color var(--transition-fast), border-color var(--transition-fast);
    margin-bottom: 4rem;
    overflow-wrap: anywhere;
  }

  .email-link:hover {
    color: var(--peacock-teal);
    border-color: var(--peacock-teal);
  }

  .social-links {
    display: flex;
    justify-content: center;
    gap: 1.5rem;
  }

  .social-links a {
    color: var(--text-secondary);
    transition: color var(--transition-fast), transform var(--transition-fast);
  }

  .social-links a:hover {
    color: var(--peacock-teal);
    transform: translateY(-2px);
  }

  @media (max-width: 480px) {
    p { font-size: 1rem; margin-bottom: 2rem; text-align: center; word-break: keep-all; hyphens: none; -webkit-hyphens: none; }
    .email-link { margin-bottom: 2.75rem; text-align: center; margin-left: auto; margin-right: auto; display: block; width: fit-content; }
    .social-links { gap: 1.25rem; justify-content: center; }
  }
</style>
