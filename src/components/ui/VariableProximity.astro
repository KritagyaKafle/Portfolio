---
// src/components/ui/VariableProximity.astro
interface Props {
  label: string;
  className?: string;
  radius?: number;
  fromFontWeight?: number;
  toFontWeight?: number;
  falloff?: string;
}

const {
  label = "Let's work together.",
  className = "",
  radius = 130,
  fromFontWeight = 500,
  toFontWeight = 900,
} = Astro.props;

// Split label into letters/characters while preserving spaces
const characters = label.split('');
---

<div 
  class={`variable-proximity-container ${className}`}
  data-radius={radius}
  data-from-weight={fromFontWeight}
  data-to-weight={toFontWeight}
>
  <h2 class="proximity-heading">
    {characters.map((char) => (
      <span class="proximity-char">{char === ' ' ? '\u00A0' : char}</span>
    ))}
  </h2>
</div>

<style>
  .variable-proximity-container {
    position: relative;
    display: inline-block;
    cursor: default;
    user-select: none;
  }

  .proximity-heading {
    font-family: var(--font-display);
    font-size: clamp(2.5rem, 5vw, 4.25rem);
    font-weight: 700;
    margin-bottom: 1rem;
    color: var(--text);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    line-height: 1.15;
    letter-spacing: -0.02em;
  }

  .proximity-char {
    display: inline-block;
    transform-origin: center bottom;
    will-change: transform, font-weight, color;
  }
</style>

<script>
  function initVariableProximity() {
    const containers = document.querySelectorAll('.variable-proximity-container');

    containers.forEach((container) => {
      const containerEl = container as HTMLElement;
      const radius = parseFloat(containerEl.dataset.radius || '130');
      const radiusSq = radius * radius;
      const fromWeight = parseInt(containerEl.dataset.fromWeight || '500', 10);
      const toWeight = parseInt(containerEl.dataset.toWeight || '900', 10);

      const chars = Array.from(containerEl.querySelectorAll('.proximity-char')) as HTMLElement[];
      const charMeta = chars.map((el) => ({
        el,
        rect: el.getBoundingClientRect(),
        weight: fromWeight,
        targetWeight: fromWeight,
        y: 0,
        targetY: 0,
      }));

      let rectsValid = false;

      function updateRects() {
        charMeta.forEach((m) => {
          m.rect = m.el.getBoundingClientRect();
        });
        rectsValid = true;
      }

      window.addEventListener('resize', () => { rectsValid = false; }, { passive: true });

      let mouseX = -9999;
      let mouseY = -9999;
      let isHovering = false;
      let rAF: number | null = null;

      function onMouseMove(e: MouseEvent) {
        if (!rectsValid) updateRects();
        mouseX = e.clientX;
        mouseY = e.clientY;
        isHovering = true;
        if (!rAF) {
          rAF = requestAnimationFrame(updateFrame);
        }
      }

      function onMouseLeave() {
        isHovering = false;
        mouseX = -9999;
        mouseY = -9999;
      }

      function updateFrame() {
        rAF = null;
        let needsNextFrame = false;

        charMeta.forEach((m) => {
          const charX = m.rect.left + m.rect.width / 2;
          const charY = m.rect.top + m.rect.height / 2;
          const dx = mouseX - charX;
          const dy = mouseY - charY;
          const distSq = dx * dx + dy * dy;

          if (isHovering && distSq < radiusSq) {
            const dist = Math.sqrt(distSq);
            const norm = (radius - dist) / radius;
            m.targetWeight = Math.round(fromWeight + (toWeight - fromWeight) * norm);
            m.targetY = norm * -6;
          } else {
            m.targetWeight = fromWeight;
            m.targetY = 0;
          }

          // Ultra-snappy lerp (0.45 factor for instant response)
          m.weight += (m.targetWeight - m.weight) * 0.45;
          m.y += (m.targetY - m.y) * 0.45;

          const roundWeight = Math.round(m.weight);
          const isTeal = m.weight > (fromWeight + (toWeight - fromWeight) * 0.35);

          m.el.style.fontWeight = `${roundWeight}`;
          m.el.style.transform = Math.abs(m.y) > 0.05 ? `translateY(${m.y.toFixed(2)}px)` : 'none';
          m.el.style.color = isTeal ? 'rgb(11, 130, 138)' : '';

          if (Math.abs(m.targetWeight - m.weight) > 0.5 || Math.abs(m.targetY - m.y) > 0.05) {
            needsNextFrame = true;
          }
        });

        if (needsNextFrame || isHovering) {
          rAF = requestAnimationFrame(updateFrame);
        }
      }

      window.addEventListener('mousemove', onMouseMove, { passive: true });
      containerEl.addEventListener('mouseleave', onMouseLeave, { passive: true });
      // Update rects initially
      updateRects();
    });
  }

  initVariableProximity();
  document.addEventListener('astro:page-load', initVariableProximity);
</script>
