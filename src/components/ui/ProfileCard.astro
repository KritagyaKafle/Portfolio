---
// src/components/ui/ProfileCard.astro
interface Props {
  name?: string;
  title?: string;
  handle?: string;
  status?: string;
  contactText?: string;
  avatarUrl?: string;
  showUserInfo?: boolean;
  enableTilt?: boolean;
  enableMobileTilt?: boolean;
  behindGlowColor?: string;
  behindGlowEnabled?: boolean;
  innerGradient?: string;
  iconUrl?: string;
  blurAvatar?: boolean;
}

const {
  name = "Kritagya Kafle",
  title = "Student",
  handle = "kritagyakafle",
  status = "Online",
  contactText = "Contact Me",
  avatarUrl = "/me.jpeg",
  showUserInfo = true,
  enableTilt = true,
  enableMobileTilt = false,
  behindGlowColor = "rgba(11, 130, 138, 0.55)",
  behindGlowEnabled = true,
  innerGradient = "linear-gradient(145deg, rgba(11, 130, 138, 0.25) 0%, rgba(122, 91, 160, 0.15) 100%)",
  blurAvatar = true,
} = Astro.props;
---

<div 
  class="profile-card-container" 
  data-enable-tilt={enableTilt ? "true" : "false"}
  data-enable-mobile-tilt={enableMobileTilt ? "true" : "false"}
>
  {behindGlowEnabled && (
    <div 
      class="profile-card-glow" 
      style={`background: ${behindGlowColor};`} 
      aria-hidden="true"
    ></div>
  )}

  <div class="profile-card-inner" style={`background-image: ${innerGradient};`}>
    <div class="profile-avatar-wrapper">
      <img 
        src={avatarUrl} 
        alt={`${name} portrait`} 
        class={`profile-avatar ${blurAvatar ? 'profile-avatar--blur' : ''}`}
        loading="lazy"
      />
      <div class="avatar-soft-overlay" aria-hidden="true"></div>
      
      {status && (
        <div class="profile-status-badge">
          <span class="status-dot"></span>
          <span class="status-text">{status}</span>
        </div>
      )}
    </div>

    {showUserInfo && (
      <div class="profile-user-info">
        <div class="user-meta">
          <h3 class="profile-name">{name}</h3>
          <span class="profile-title">{title}</span>
        </div>
        
        {contactText && (
          <a href="#contact" class="profile-contact-btn">
            <span>{contactText}</span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" width="16" height="16"><line x1="5" y1="12" x2="19" y2="12"/><polyline points="12 5 19 12 12 19"/></svg>
          </a>
        )}
      </div>
    )}
  </div>
</div>

<style>
  .profile-card-container {
    position: relative;
    width: 100%;
    max-width: 380px;
    margin: 0 auto;
    perspective: 1000px;
  }

  /* Behind Glow Ambient Effect */
  .profile-card-glow {
    position: absolute;
    inset: -12px;
    border-radius: 32px;
    filter: blur(28px);
    opacity: 0.75;
    z-index: 0;
    transition: opacity 0.4s ease, filter 0.4s ease;
    pointer-events: none;
  }

  .profile-card-container:hover .profile-card-glow {
    opacity: 0.95;
    filter: blur(36px);
  }

  /* Inner Card Container */
  .profile-card-inner {
    position: relative;
    z-index: 1;
    border-radius: 24px;
    background-color: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.6);
    box-shadow: 
      0 20px 48px rgba(0, 0, 0, 0.12),
      0 4px 12px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
    overflow: hidden;
    transform-style: preserve-3d;
    transition: border-color 0.3s ease, box-shadow 0.3s ease;
    will-change: transform;
  }

  .profile-card-container:hover .profile-card-inner {
    border-color: rgba(11, 130, 138, 0.3);
    box-shadow: 
      0 28px 60px rgba(11, 130, 138, 0.18),
      0 6px 16px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.95);
  }

  /* Avatar Wrapper */
  .profile-avatar-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 4.8;
    overflow: hidden;
    background-color: #1a1a1a;
  }

  /* Clean Aesthetic Soft Blur on Portrait */
  .profile-avatar {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 20%;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1), filter 0.6s ease;
  }

  .profile-avatar--blur {
    filter: blur(1.5px) contrast(1.02) brightness(0.98);
  }

  .profile-card-container:hover .profile-avatar--blur {
    filter: blur(0px) contrast(1.04) brightness(1.02);
    transform: scale(1.04);
  }

  /* Soft Vignette Overlay on Portrait */
  .avatar-soft-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom, 
      transparent 50%, 
      rgba(0, 0, 0, 0.35) 85%, 
      rgba(0, 0, 0, 0.65) 100%
    );
    pointer-events: none;
  }

  /* Status Badge */
  .profile-status-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    z-index: 3;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 12px;
    background: rgba(0, 0, 0, 0.45);
    backdrop-filter: blur(12px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.15);
  }

  .status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: #10b981;
    box-shadow: 0 0 8px #10b981;
    animation: statusPulse 2s infinite ease-in-out;
  }

  @keyframes statusPulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(0.85); }
  }

  .status-text {
    font-family: var(--font-body);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.05em;
    color: rgba(255, 255, 255, 0.95);
    text-transform: uppercase;
  }

  /* User Info Footer */
  .profile-user-info {
    padding: 1.25rem 1.5rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    background: rgba(255, 255, 255, 0.6);
    backdrop-filter: blur(10px);
    border-top: 1px solid rgba(255, 255, 255, 0.4);
  }

  .user-meta {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .profile-name {
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 800;
    color: var(--text);
    letter-spacing: -0.01em;
    margin: 0;
    line-height: 1.2;
  }

  .profile-title {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    color: var(--peacock-teal);
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  /* Contact Button */
  .profile-contact-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-body);
    font-size: 0.8rem;
    font-weight: 600;
    color: #ffffff;
    background: var(--peacock-teal);
    padding: 8px 14px;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(11, 130, 138, 0.25);
  }

  .profile-contact-btn:hover {
    background: #086970;
    transform: translateY(-1px);
    box-shadow: 0 6px 16px rgba(11, 130, 138, 0.35);
  }
</style>

<script>
  import gsap from 'gsap';

  function initProfileCardTilt() {
    const containers = document.querySelectorAll('.profile-card-container');

    containers.forEach((container) => {
      const containerEl = container as HTMLElement;
      const enableTilt = containerEl.dataset.enableTilt === 'true';
      const enableMobile = containerEl.dataset.enableMobileTilt === 'true';

      const isMobile = window.innerWidth <= 768;
      if (!enableTilt || (isMobile && !enableMobile)) return;

      const inner = containerEl.querySelector('.profile-card-inner') as HTMLElement;
      const glow = containerEl.querySelector('.profile-card-glow') as HTMLElement;
      if (!inner) return;

      containerEl.addEventListener('mousemove', (e: MouseEvent) => {
        const rect = containerEl.getBoundingClientRect();
        const x = e.clientX - rect.left;
        const y = e.clientY - rect.top;
        const centerX = rect.width / 2;
        const centerY = rect.height / 2;

        const rotateX = ((y - centerY) / centerY) * -12;
        const rotateY = ((x - centerX) / centerX) * 12;

        gsap.to(inner, {
          rotateX: rotateX,
          rotateY: rotateY,
          duration: 0.3,
          ease: 'power2.out',
          transformPerspective: 1000
        });

        if (glow) {
          gsap.to(glow, {
            x: (x - centerX) * 0.15,
            y: (y - centerY) * 0.15,
            duration: 0.3,
            ease: 'power2.out'
          });
        }
      });

      containerEl.addEventListener('mouseleave', () => {
        gsap.to(inner, {
          rotateX: 0,
          rotateY: 0,
          duration: 0.5,
          ease: 'power2.out'
        });

        if (glow) {
          gsap.to(glow, {
            x: 0,
            y: 0,
            duration: 0.5,
            ease: 'power2.out'
          });
        }
      });
    });
  }

  initProfileCardTilt();
  document.addEventListener('astro:page-load', initProfileCardTilt);
</script>
