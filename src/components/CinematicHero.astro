---
import fs from 'node:fs';
import path from 'node:path';

function getIcon(name: string) {
  try { return fs.readFileSync(path.join(process.cwd(), 'src/assets/icons', `${name}.svg`), 'utf-8'); }
  catch (e) { return ''; }
}

const graphicsSkills = [
  { name: 'Photoshop', icon: 'photoshop' },
  { name: 'Premiere Pro', icon: 'premiere-pro' },
  { name: 'CapCut', icon: 'capcut' },
  { name: 'Illustrator', icon: 'illustrator' },
  { name: 'Canva', icon: 'canva' },
  { name: 'After Effects', icon: 'after-effects' }
];

const devSkills = [
  { name: 'Full Stack', icon: 'frontend' },
  { name: 'Web Scraping', icon: 'web-scraping' },
  { name: 'Automation', icon: 'automation' },
  { name: 'Agentic AI', icon: 'react' },
  { name: 'TypeScript', icon: 'typescript' },
  { name: 'Micro SaaS', icon: 'gsap' }
];
---

<section class="cinematic-master">
  <div class="canvas-wrapper">
    <canvas id="master-canvas"></canvas>
    <div class="canvas-vignette"></div>
    <div class="canvas-bottom-fade" aria-hidden="true"></div>
    <div class="hero-glow-accent" aria-hidden="true"></div>
  </div>

  <div class="layer title-layer">
    <div class="title-text-wrapper">
      <h1 class="title-primary">
        {'KRITAGYA KAFLE'.split('').map(char => (
          <span class="char">{char === ' ' ? '\u00A0' : char}</span>
        ))}
      </h1>
      <div class="title-ghost" aria-hidden="true">
        {'KRITAGYA KAFLE'.split('').map(char => (
          <span class="char">{char === ' ' ? '\u00A0' : char}</span>
        ))}
      </div>
    </div>
    <div class="subtitle-wrapper">
      <h2 class="title-subtitle">
        <span class="italic-accent">Graphics</span> Meets Development
      </h2>
    </div>
  </div>

  <div class="layer skills-layer">
    <div class="skills-column graphics-column">
      <div class="cards-cluster">
        {graphicsSkills.map((skill, index) => (
          <div class="skill-card graphics-card" style={`--curve: ${Math.sin((index / 5) * Math.PI)};`}>
            <span class="icon" set:html={getIcon(skill.icon)} />
            <span class="label">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>
    
    <div class="skills-column dev-column">
      <div class="cards-cluster">
        {devSkills.map((skill, index) => (
          <div class="skill-card dev-card" style={`--curve: ${Math.sin((index / 5) * Math.PI)};`}>
            <span class="icon" set:html={getIcon(skill.icon)} />
            <span class="label">{skill.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <div class="layer bridge-layer">
    <h2>See what I've built.</h2>
  </div>
</section>

<style>
  .cinematic-master {
    position: relative;
    width: 100vw;
    left: 50%;
    right: 50%;
    margin-left: -50vw;
    margin-right: -50vw;
    height: 100vh;
    height: 100svh;
    background: var(--bg);
    overflow: hidden;
  }

  .canvas-wrapper {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    overflow: hidden;
    z-index: 1;
    background: var(--bg);
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
    opacity: 0.82;
    mix-blend-mode: luminosity; 
    transition: opacity 0.5s ease;
    contain: strict;
  }

  /* Soft multi-stop vignette - eliminates hard rectangular canvas borders */
  .canvas-vignette {
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, transparent 35%, color-mix(in srgb, var(--bg) 55%, transparent) 75%, var(--bg) 100%);
    pointer-events: none;
  }

  /* Multi-stage curved bottom dissolve - smooth blend into content flow */
  .canvas-bottom-fade {
    position: absolute;
    inset: 35% 0 0;
    z-index: 2;
    pointer-events: none;
    background: linear-gradient(
      to bottom, 
      transparent 0%, 
      color-mix(in srgb, var(--bg) 20%, transparent) 30%, 
      color-mix(in srgb, var(--bg) 65%, transparent) 65%, 
      var(--bg) 100%
    );
  }

  /* Subtle ambient teal light glow at bottom boundary */
  .hero-glow-accent {
    position: absolute;
    bottom: -100px;
    left: 50%;
    transform: translateX(-50%);
    width: 80vw;
    max-width: 900px;
    height: 200px;
    border-radius: 50%;
    background: radial-gradient(ellipse at center, rgba(11, 130, 138, 0.12) 0%, rgba(11, 130, 138, 0.03) 50%, transparent 80%);
    pointer-events: none;
    z-index: 3;
    filter: blur(40px);
  }

  .layer {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 10;
    pointer-events: none;
    perspective: 1200px;
  }

  .char {
    display: inline-block;
  }

  /* --- Title Layer --- */
  .title-text-wrapper {
    position: relative;
    z-index: 2;
    max-width: calc(100% - 2rem);
  }
  .title-primary {
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: #fff;
    mix-blend-mode: exclusion;
    display: flex;
    justify-content: center;
    white-space: nowrap;
    text-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
  }
  .title-ghost {
    position: absolute;
    top: 4px; left: -4px;
    font-family: var(--font-display);
    font-size: clamp(3rem, 8vw, 7.5rem);
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px rgba(0,0,0,0.18);
    display: flex;
  }
  .subtitle-wrapper {
    max-width: calc(100% - 2rem);
    margin-top: 1.5rem;
    overflow: hidden;
    z-index: 2;
    text-align: center;
  }
  .title-subtitle {
    display: inline-block;
    font-family: var(--font-display);
    font-size: clamp(1rem, 2.5vw, 1.5rem);
    font-weight: 500;
    letter-spacing: 0.1em;
    color: var(--text-secondary);
    line-height: 1.35;
    -webkit-text-stroke: 0.55px rgba(255, 255, 255, 0.9);
    paint-order: stroke fill;
    text-shadow: 0 1px 10px rgba(0, 0, 0, 0.24);
  }
  .italic-accent { font-style: italic; color: var(--peacock-teal); font-family: serif; font-size: 110%; }

  /* Skills Layer layout spacing */
  .skills-layer {
    flex-direction: row;
    justify-content: space-between;
    padding: 0 10%;
    opacity: 1;
  }

  .skills-column {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    width: 35%;
    max-width: 320px;
    pointer-events: auto;
  }
  .graphics-column { align-items: flex-start; }
  .dev-column { align-items: flex-end; text-align: right; }

  .cards-cluster { display: flex; flex-direction: column; gap: 14px; }
  .graphics-column .cards-cluster { align-items: flex-start; }
  .dev-column .cards-cluster { align-items: flex-end; }

  /* Frosted Glassmorphic Skill Cards - Soft blended borders */
  .skill-card {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    padding: 7px 22px 7px 7px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    border: 1px solid rgba(255, 255, 255, 0.65);
    border-radius: 40px;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--peacock-teal);
    text-transform: uppercase;
    letter-spacing: 0.04em;
    white-space: nowrap;
    box-shadow: 
      0 12px 32px rgba(11, 130, 138, 0.09), 
      0 2px 8px rgba(0, 0, 0, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
    
    opacity: 0;
    transform: scale(0.8) translateY(20px);
    position: relative;
    transition: border-color var(--transition-fast), box-shadow var(--transition-fast);
  }

  .skill-card:hover {
    border-color: rgba(11, 130, 138, 0.4);
    box-shadow: 
      0 16px 40px rgba(11, 130, 138, 0.16), 
      0 4px 12px rgba(0, 0, 0, 0.08),
      inset 0 1px 0 rgba(255, 255, 255, 0.9);
  }
  
  .graphics-card { left: calc(var(--curve) * -30px); }
  .dev-card { right: calc(var(--curve) * -30px); }

  .skill-card .icon {
    display: flex;
    justify-content: center;
    align-items: center;
    width: 38px;
    height: 38px;
    background: #111111;
    border-radius: 50%;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  }

  .skill-card :global(svg) { width: 18px; height: 18px; fill: #ffffff; color: #ffffff; }

  /* Bridge Layer */
  .bridge-layer { opacity: 0; }
  .bridge-layer h2 {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 4rem);
    font-weight: 700;
    color: var(--text);
  }

  @media (max-width: 768px) {
    .title-primary,
    .title-ghost {
      font-size: clamp(1.75rem, 8.5vw, 4.25rem);
      text-align: center;
      justify-content: center;
    }

    .title-ghost { top: 3px; left: -3px; }

    .title-subtitle {
      font-size: clamp(0.75rem, 2.8vw, 1rem);
      letter-spacing: 0.05em;
      text-align: center;
    }

    .skills-layer {
      flex-direction: row;
      justify-content: center;
      align-items: center;
      gap: 0.75rem;
      padding: 0 1rem;
      width: 100%;
      max-width: 440px;
      margin: 0 auto;
      box-sizing: border-box;
    }

    .skills-column {
      width: calc(50% - 0.5rem);
      max-width: 190px;
      align-items: center;
    }

    .graphics-column, .dev-column {
      align-items: center;
      text-align: center;
    }

    .cards-cluster { 
      gap: 8px; 
      width: 100%;
      align-items: center !important; 
    }

    .skill-card {
      left: 0 !important;
      right: 0 !important;
      width: 100%;
      box-sizing: border-box;
      padding: 5px 10px 5px 5px;
      gap: 8px;
      font-size: 0.72rem;
      justify-content: center;
    }

    .skill-card .label {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      text-align: center;
    }

    .skill-card .icon {
      width: 28px;
      height: 28px;
      flex-shrink: 0;
    }

    .skill-card :global(svg) {
      width: 14px;
      height: 14px;
    }
  }

  @media (max-width: 480px) {
    .canvas-vignette {
      background: radial-gradient(ellipse at center, transparent 40%, color-mix(in srgb, var(--bg) 60%, transparent) 100%);
    }

    .canvas-bottom-fade {
      inset: 60% 0 0;
      background: linear-gradient(to bottom, transparent 0%, color-mix(in srgb, var(--bg) 40%, transparent) 50%, var(--bg) 100%);
    }

    .subtitle-wrapper { margin-top: 0.9rem; text-align: center; }

    .skills-layer {
      gap: 0.4rem;
      padding: 0 0.5rem;
      max-width: 360px;
    }

    .skills-column {
      max-width: 165px;
    }

    .cards-cluster { gap: 6px; }

    .skill-card {
      gap: 5px;
      padding: 3px 6px 3px 3px;
      font-size: 0.65rem;
      letter-spacing: 0.01em;
      border-radius: 24px;
      justify-content: center;
    }

    .skill-card .icon {
      width: 24px;
      height: 24px;
    }

    .skill-card :global(svg) { width: 12px; height: 12px; }
  }

  @media (max-width: 360px) {
    .skills-layer { padding: 0 0.35rem; }
    .skill-card { font-size: 0.58rem; padding-right: 5px; }
  }
</style>

<script>
  import { initCinematicMaster } from '../scripts/cinematic-hero-v3';
  initCinematicMaster();
</script>
