---
import '../styles/global.css';
import SwarmCursor from '../components/ui/SwarmCursor.astro';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    
    <!-- Preload LCP initial hero frame -->
    <link rel="preload" as="image" href="/frames/hero-1-mobile/frame-000.webp" media="(max-width: 768px)" fetchpriority="high" />
    <link rel="preload" as="image" href="/frames/hero-1/frame-000.webp" media="(min-width: 769px)" fetchpriority="high" />

    <!-- Google Fonts - Non-blocking load with display=swap -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;700;800&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" /></noscript>
    
    <title>{title}</title>
  </head>
  <body>
    <!-- Persistent texture across all scenes -->
    <div class="grain-overlay" aria-hidden="true"></div>
    
    <SwarmCursor
      color="rgba(220, 225, 235, 0.35)"
      accentColor="rgba(255, 255, 255, 0.5)"
      count={8}
      size={4}
      speed={2.2}
      spread={65}
      wander={0.25}
      trail={0.75}
      scatterOnClick={true}
    >
      <main>
        <slot />
      </main>
    </SwarmCursor>
  </body>
</html>
